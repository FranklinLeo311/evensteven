# AI: "auto" uses Claude when ANTHROPIC_API_KEY is set, otherwise Gemini
AI_PROVIDER=auto
# your own Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# or a free Google AI Studio key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# comma-separated fallbacks; free models are sometimes busy
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest
# PayPal developer dashboard -> Apps & Credentials -> Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DEFAULT_CURRENCY=USD
PUBLIC_URL=http://localhost:8090
# Limits on the endpoints that call the AI (protects the API bill when the demo is public)
AI_CALLS_PER_IP_PER_HOUR=15
AI_CALLS_PER_DAY=300
